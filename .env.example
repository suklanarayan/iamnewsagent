# Environment variables for iamquickagent.com
# For local development and Vercel deployment:
# Set these variables in your Vercel Project Settings > Environment Variables

# Optional Firebase Firestore Configuration (for cloud persistence across devices)
# If left unset, the application automatically uses high-performance local IndexedDB/localStorage fallback.
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""

# Optional Gemini AI Key for Auto-generating Key Takeaways & Summaries
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Base Application URL
APP_URL="https://iamquickagent.com"
