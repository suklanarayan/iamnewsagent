{
  "entities": {
    "Article": {
      "title": "Article",
      "description": "A news publication article with rich editorial metadata",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "slug": { "type": "string", "maxLength": 200 },
        "headline": { "type": "string", "maxLength": 500 },
        "deck": { "type": "string", "maxLength": 2000 },
        "content": { "type": "string", "maxLength": 200000 },
        "category": { "type": "string", "maxLength": 50 },
        "tags": { "type": "array" },
        "authorId": { "type": "string", "maxLength": 128 },
        "featuredImage": { "type": "string", "maxLength": 2000 },
        "imageCaption": { "type": "string", "maxLength": 1000 },
        "status": { "type": "string" },
        "isBreaking": { "type": "boolean" },
        "isExplainer": { "type": "boolean" },
        "publishedAt": { "type": "string" },
        "updatedAt": { "type": "string" },
        "readTimeMinutes": { "type": "number" },
        "views": { "type": "number" }
      },
      "required": ["id", "slug", "headline", "category"]
    },
    "LiveStory": {
      "title": "LiveStory",
      "description": "A real-time live story sequence for the top radar bar",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 300 },
        "subtitle": { "type": "string", "maxLength": 1000 },
        "image": { "type": "string", "maxLength": 2000 },
        "isLive": { "type": "boolean" },
        "category": { "type": "string", "maxLength": 50 },
        "articleSlug": { "type": "string", "maxLength": 200 },
        "destinationUrl": { "type": "string", "maxLength": 2000 },
        "keyPoints": { "type": "array" },
        "order": { "type": "number" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "title"]
    },
    "Author": {
      "title": "Author",
      "description": "A news author and journalist profile",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 150 },
        "role": { "type": "string", "maxLength": 150 },
        "avatar": { "type": "string", "maxLength": 2000 },
        "bio": { "type": "string", "maxLength": 2000 },
        "location": { "type": "string", "maxLength": 100 },
        "verified": { "type": "boolean" },
        "joinedDate": { "type": "string", "maxLength": 50 }
      },
      "required": ["id", "name", "role"]
    }
  },
  "firestore": {
    "/articles/{articleId}": {
      "schema": "Article",
      "description": "Collection of published news articles and drafts"
    },
    "/live_stories/{storyId}": {
      "schema": "LiveStory",
      "description": "Collection of live story sequences and ordered visual radar briefs"
    },
    "/authors/{authorId}": {
      "schema": "Author",
      "description": "Collection of journalists and staff contributors"
    },
    "/site_settings/{settingId}": {
      "description": "App configuration settings such as explore categories, trending, and ad briefings"
    }
  }
}
