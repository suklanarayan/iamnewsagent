rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    // Public News Articles: readable by public (get and list queries for readers on desktop & mobile)
    match /articles/{articleId} {
      allow get, list: if true;
      allow create, update: if isValidId(articleId)
        && request.resource.data.id is string
        && request.resource.data.headline is string
        && request.resource.data.headline.size() > 0
        && request.resource.data.headline.size() <= 1000;
      allow delete: if isValidId(articleId);
    }

    // Live stories & ordered sequences: readable by public across all devices
    match /live_stories/{storyId} {
      allow get, list: if true;
      allow create, update: if isValidId(storyId)
        && request.resource.data.id is string
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 1000;
      allow delete: if isValidId(storyId);
    }

    // Authors and contributors
    match /authors/{authorId} {
      allow get, list: if true;
      allow create, update: if isValidId(authorId)
        && request.resource.data.id is string
        && request.resource.data.name is string;
      allow delete: if isValidId(authorId);
    }

    // App configurations, explore categories, and site settings
    match /site_settings/{settingId} {
      allow get, list: if true;
      allow write: if isValidId(settingId);
    }
  }
}
